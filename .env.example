# AI Werewolf - 环境配置
# API keys 需要配置在 shell 环境变量中（如 ~/.zshrc）：
#   export ANTHROPIC_AUTH_TOKEN="sk-xxx"      # Claude Opus/Sonnet
#   export SILICONFLOW_API_KEY="sk-xxx"       # 硅基流动（DeepSeek/Kimi/Qwen）
#   export DEEPSEEK_API_KEY="sk-xxx"          # DeepSeek 官方 API
#   export CUSTOM_LLM_API_KEY="sk-xxx"        # 自定义 OpenAI-compatible 模型
#   export OPENAI_API_KEY="sk-xxx"            # OpenAI GPT（可选）

# Claude base URL (留空则使用 Anthropic 官方地址，或设置自定义代理)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI base URL (留空则使用官方地址，或设置自定义代理)
# OPENAI_BASE_URL=https://api.openai.com

# Custom OpenAI-compatible base URL
# CUSTOM_LLM_BASE_URL=https://llm-gateway.example.test/v1

# Server
PORT=3000
